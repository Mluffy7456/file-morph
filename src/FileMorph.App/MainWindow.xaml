<Window x:Class="FileMorph.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileMorph"
        Width="1040"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="FileMorph" />
                <TextBlock Margin="0,5,0,0" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Локальная конвертация. Просто и безопасно." />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="ALPHA · ЛОКАЛЬНЫЙ РЕЖИМ" />
        </Grid>

        <TabControl Grid.Row="1" Background="{StaticResource CanvasBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}" Padding="4" Margin="0,0,0,18">
            <TabItem Header="Конвертация" IsSelected="True" />
            <TabItem Header="Очередь" />
            <TabItem Header="История" />
            <TabItem Header="Пресеты" />
            <TabItem Header="Настройки" />
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                CornerRadius="18" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="Конвертация файлов" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Добавьте файл, чтобы подготовить задание." />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,22,0,22" BorderBrush="#FF484B52"
                        BorderThickness="1" CornerRadius="14" Background="#FF151619"
                        AllowDrop="True" DragOver="DropZone_OnDragOver" Drop="DropZone_OnDrop">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="38" Text="＋" />
                        <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="Medium" Text="Перетащите файл сюда" />
                        <TextBlock Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="или выберите его на компьютере" />
                        <Button Margin="0,18,0,0" Content="Выбрать файл…" Click="SelectFile_OnClick" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Выбранный файл" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedFileText" Margin="0,5,12,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Файл не выбран" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="170" IsEnabled="False"
                            Content="Конвертировать"
                            ToolTip="Обработчики форматов будут подключены на следующем этапе." />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,16,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                   Text="Исходные файлы не изменяются. Обработка выполняется локально." />
    </Grid>
</Window>
